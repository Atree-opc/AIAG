# Docker image and container settings
POSTGRES_IMAGE=postgres:16
CONTAINER_NAME=aiag-postgres
HOST_PORT=5432
DATA_VOLUME=aiag-postgres-data
TZ=UTC

# Database bootstrap settings
POSTGRES_DB=project_db
POSTGRES_USER=project_user
POSTGRES_PASSWORD=ChangeMe_123!

# Deployment behavior
HEALTHCHECK_TIMEOUT=120
IMPORT_SEED_DATA=1
REPORT_FILE=deploy/postgres/deployment-report.txt
